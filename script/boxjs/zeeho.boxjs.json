{
  "id": "zeeho",
  "name": "极核ZEEHO",
  "author": "@ZEEHO",
  "icon": "https://raw.githubusercontent.com/cluck798/ZEEHO/main/ZEEHO.png",
  "repo": "https://github.com/cluck798/ZEEHO",
  "apps": [
    {
      "id": "zeeho_box",
      "name": "极核ZEEHO增强面板",
      "keys": ["zeeho_data", "zeeho_config", "zeeho_logs", "zeeho_app_appId", "zeeho_app_appSecret", "zeeho_h5_appId", "zeeho_h5_appSecret"],
      "settings": [
        {
          "id": "zeeho_data",
          "name": "账号列表（Token）",
          "val": "[]",
          "type": "textarea",
          "autoGrow": true,
          "rows": 6,
          "desc": "JSON 数组，格式: [{\"userName\":\"昵称\",\"userId\":\"用户ID\",\"token\":\"登录Token\",\"barkKey\":\"Bark推送Key(可留空)\"}]"
        },
        {
          "id": "zeeho_config",
          "name": "配置（签名密钥）",
          "val": "{}",
          "type": "textarea",
          "autoGrow": true,
          "rows": 6,
          "desc": "JSON: {\"app\":{\"appId\":\"\",\"appSecret\":\"\"},\"h5\":{\"appId\":\"\",\"appSecret\":\"\"},\"vehicleAesKey\":\"32位云端控车密钥\",\"community\":{\"enablePost\":true,\"enableLike\":true,\"enableComment\":true,\"enableShare\":true,\"enableDelete\":true}}"
        },
        {
          "id": "zeeho_logs",
          "name": "运行日志",
          "val": "[]",
          "type": "textarea",
          "autoGrow": true,
          "rows": 8,
          "readOnly": true,
          "desc": "脚本运行日志（自动写入，仅供查看，可手动清空）"
        }
      ],
      "author": "@ZEEHO",
      "repo": "https://github.com/cluck798/ZEEHO",
      "script": "https://raw.githubusercontent.com/cluck798/ZEEHO/main/script/zeeho_box_enhanced.js",
      "icons": [
        "https://raw.githubusercontent.com/cluck798/ZEEHO/main/ZEEHO.png"
      ]
    },
    {
      "id": "zeeho_sign",
      "name": "极核ZEEHO每日签到",
      "keys": ["zeeho_data", "zeeho_logs"],
      "settings": [
        {
          "id": "zeeho_data",
          "name": "账号列表（Token）",
          "val": "[]",
          "type": "textarea",
          "autoGrow": true,
          "rows": 6,
          "desc": "JSON 数组，格式: [{\"userName\":\"昵称\",\"userId\":\"用户ID\",\"token\":\"登录Token\",\"barkKey\":\"Bark推送Key(可留空)\"}]"
        }
      ],
      "author": "@ZEEHO",
      "repo": "https://github.com/cluck798/ZEEHO",
      "script": "https://raw.githubusercontent.com/cluck798/ZEEHO/main/script/zeeho.js"
    }
  ]
}
