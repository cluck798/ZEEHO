#!name=极核ZEEHO
#!desc=极核ZEEHO自动签到 + 社区积分任务 + 盲盒抽奖 + 车辆状态面板 + 远程控车（寻车/鸣笛/坐垫/开锁/关锁）。自动抓取 Token 与 appId/appSecret，浏览器访问 http://zeeho.box 管理。仅供学习研究。
#!author=@ZEEHO
#!homepage=https://github.com/cluck798/ZEEHO
#!icon=https://raw.githubusercontent.com/cluck798/ZEEHO/main/ZEEHO.png
#!version=2.15.5
#!system=ios
#!date=2026-10-07

[Script]
# 面板 + 极核API自动捕获appId/appSecret（访问 http://zeeho.box 打开面板）
http-request ^https?://(zeeho\.box|.*zeehoev\.com)/.* script-path=https://raw.githubusercontent.com/cluck798/ZEEHO/refs/heads/main/script/zeeho_box_enhanced.js?v=2.15.5, requires-body=true, timeout=60, tag=极核面板

# 极核Token自动捕获（打开极核App → 我的页面）
http-response ^https:\/\/tapi\.zeehoev\.com\/v1\.0\/mine\/cfmotoservermine\/setting script-path=https://raw.githubusercontent.com/cluck798/ZEEHO/refs/heads/main/script/zeeho.js, requires-body=true, timeout=30, tag=极核抓Token

# 极核每日签到（每天 07:00，可自行修改时间）
cron "0 7 * * *" script-path=https://raw.githubusercontent.com/cluck798/ZEEHO/refs/heads/main/script/zeeho.js, timeout=120, tag=极核每日签到

[MITM]
hostname = tapi.zeehoev.com, h5.zeehoev.com, zeeho.box