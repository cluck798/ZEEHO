<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="极核 ZEEHO"
            android:textColor="#E8ECF5"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_online"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● 打开 App"
            android:textColor="#F59E0B"
            android:textSize="10sp"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="3dp"
            android:src="@android:drawable/ic_popup_sync"
            android:contentDescription="刷新"
            android:background="@android:color/transparent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="1dp">

        <TextView
            android:id="@+id/widget_model"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#5E6E88"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_chip_seat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="坐垫已关"
                android:textColor="#93A0B8"
                android:textSize="9sp"
                android:background="@drawable/widget_chip_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_chip_lock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已关锁"
                android:textColor="#93A0B8"
                android:textSize="9sp"
                android:background="@drawable/widget_chip_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginStart="4dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- 照片 + 胎压 / 定位 / 签到（v2.16.45 与电量区互换位置） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="7dp">

        <ImageView
            android:id="@+id/widget_img"
            android:layout_width="92dp"
            android:layout_height="62dp"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:background="@drawable/widget_img_bg"
            android:contentDescription="车辆" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/widget_tires"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#93A0B8"
                android:textSize="9.5sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_tires2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#93A0B8"
                android:textSize="9.5sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_loc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#93A0B8"
                android:textSize="9.5sp"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_sign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="签到 --"
                android:textColor="#7E90B0"
                android:textSize="9.5sp"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- 电量区（下移） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/widget_soc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#FFFFFF"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="%"
            android:textColor="#93A3C0"
            android:textSize="11sp"
            android:layout_marginStart="1dp"
            android:layout_marginBottom="3dp" />

        <TextView
            android:id="@+id/widget_range"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="-- km"
            android:textColor="#93A3C0"
            android:textSize="11sp"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="3dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_volt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- V"
            android:textColor="#93A3C0"
            android:textSize="11sp"
            android:layout_marginBottom="3dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_socbar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progressDrawable="@drawable/widget_socbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/widget_state"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#7E90B0"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#4E5D7A"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
